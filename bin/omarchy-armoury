#!/usr/bin/env bash
# omarchy-armoury — backend helper for the Omarchy Armoury Crate plugin.
#
# The QML shell runs as your user and must never sudo directly. This script
# is the ONLY place that talks to hardware, and only through Omarchy's
# preinstalled daemons:
#   - asusctl/asusd   : profiles, fan curves, aura/leds, battery, armoury attrs, anime/slash
#   - supergfxctl     : GPU mode switching (per plugin design; NOT asusctl dgpu_disable)
#
# Read commands print TSV (`key<TAB>value`) for easy QML parsing.
# Write commands rely on the daemons' own polkit prompts — do NOT wrap in sudo.
#
# GPU switching policy (mirrors Omarchy's trigger>hardware>Hybrid GPU flow):
#   - Integrated <-> Hybrid is DELEGATED to `omarchy-toggle-hybrid-gpu`
#     (terminal, sudo, gum confirm). That script rewrites /etc/supergfxd.conf
#     and reboots instead of live-switching, and manages the Integrated boot
#     workaround (delay-start.conf drop-in) + the force-igpu sleep hook.
#     This helper never live-switches into/out of Integrated.
#   - Hybrid <-> AsusMuxDgpu goes direct via `supergfxctl -m` (MUX flip always
#     needs a reboot; logout is NOT enough).
#   - Anything involving Ultimate <-> Integrated is two-step via Hybrid
#     (Ultimate->Hybrid, reboot, then Omarchy toggle to Integrated).
set -u

# asusctl prints errors (e.g. "asusd is not running") with ANSI colors to
# stdout when there is no daemon — and no --no-color flag. Everything captured
# from asusctl goes through here: strip escapes, then refuse daemon-down
# output so it can never become a fake profile / battery / kbd value.
have() { command -v "$1" >/dev/null 2>&1; }

strip_ansi() { sed -e 's/\x1b\[[0-9;]*[mK]//g'; }
asusctl_out() {
  # runs asusctl, prints cleaned stdout; returns 1 if asusd is down.
  local out=""
  out=$(NO_COLOR=1 TERM=dumb asusctl "$@" 2>/dev/null | strip_ansi || true)
  if [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ] || printf '%s' "$out" | grep -qi "asusd is not running\|could not get asusd\|is asusd.service running"; then
    return 1
  fi
  printf '%s' "$out"
}

# supergfxd can wedge and block clients forever (see omarchy-hw-hybrid-gpu).
# Every supergfxctl call goes through here: timeout + 3 attempts.
sgfx() {
  local out="" attempt=0
  for attempt in 1 2 3; do
    if out=$(timeout --kill-after=1s 3s supergfxctl "$@" 2>/dev/null) && [ -n "$out" ]; then
      printf '%s' "$out"
      return 0
    fi
    [ "$attempt" -lt 3 ] && sleep 1
  done
  return 1
}

cmd_status() {
  # TSV: asus(bool) sgfx(bool) asusd(bool) dmi_product
  local asus=false sgfx=false asusd=false product=""
  have asusctl && asus=true
  have supergfxctl && sgfx=true
  if have systemctl; then
    systemctl is-active --quiet asusd 2>/dev/null && asusd=true
    systemctl is-active --quiet supergfxd 2>/dev/null || true
  fi
  product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo unknown)
  printf 'asus\t%s\nsgfx\t%s\nasusd\t%s\nproduct\t%s\n' "$asus" "$sgfx" "$asusd" "$product"
}

cmd_profiles() {
  # TSV: profile<TAB>active(1/0). Never emits fake data when asusd is down.
  if ! have asusctl; then printf 'error\t%s\n' "asusctl-missing"; return 1; fi
  local active="" list=""
  if ! active=$(asusctl_out profile get); then
    printf 'error\t%s\n' "asusd-down"; return 1
  fi
  active=$(printf '%s' "$active" | sed -n '1s/^[^:]*:[[:space:]]*//p' | tr -d '\r\n')
  if ! list=$(asusctl_out profile list); then
    printf 'error\t%s\n' "asusd-down"; return 1
  fi
  if [ -z "$(echo "$list" | tr -d '[:space:]')" ]; then
    list="Quiet
Balanced
Performance"
  fi
  while IFS= read -r p; do
    p=$(echo "$p" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [ -z "$p" ] && continue
    # list output may be "Profile: Quiet" style — take last word-ish token
    p=$(echo "$p" | sed 's/^.*:[[:space:]]*//')
    if [ "$p" = "$active" ]; then
      printf '%s\t1\n' "$p"
    else
      printf '%s\t0\n' "$p"
    fi
  done <<< "$list"
}

cmd_profile_set() { # <Quiet|Balanced|Performance>
  [ $# -ge 1 ] || { echo "usage: $0 profile-set <profile>" >&2; return 2; }
  exec asusctl profile set "$1"
}

cmd_profile_next() { exec asusctl profile next; }

cmd_gpu() {
  # TSV: mode, supported[], pending_mode, pending_action, power, vendor,
  # plus Omarchy Integrated-support files (delay_start, force_igpu).
  have supergfxctl || { printf 'error\t%s\n' "supergfxctl-missing"; return 1; }
  local mode="" sup="" pmode="" paction="" power="" vendor=""
  mode=$(sgfx -g || true)
  sup=$(sgfx -s || true)
  pmode=$(sgfx -P || true)
  paction=$(sgfx -p || true)
  power=$(sgfx -S || true)
  vendor=$(sgfx -V || true)
  local delay_start=false force_igpu=false
  [ -f /etc/systemd/system/supergfxd.service.d/delay-start.conf ] && delay_start=true
  [ -x /usr/lib/systemd/system-sleep/force-igpu ] && force_igpu=true
  if [ -z "$mode" ]; then
    printf 'error\t%s\n' "supergfxd-not-responding"; return 1
  fi
  printf 'mode\t%s\nsupported\t%s\npending_mode\t%s\npending_action\t%s\npower\t%s\nvendor\t%s\ndelay_start\t%s\nforce_igpu\t%s\n' \
    "$mode" "$sup" "$pmode" "$paction" "$power" "$vendor" "$delay_start" "$force_igpu"
}

cmd_gpu_set() { # <Hybrid|AsusMuxDgpu> — direct MUX-capable modes only.
  [ $# -ge 1 ] || { echo "usage: $0 gpu-set <Hybrid|AsusMuxDgpu>" >&2; return 2; }
  case "$1" in
    Hybrid|AsusMuxDgpu) ;;
    Integrated|Vfio|*)
      echo "refusing '$1': Integrated<->Hybrid goes through 'omarchy-armoury gpu-toggle' (Omarchy flow); Vfio is out of scope" >&2
      return 2 ;;
  esac
  have supergfxctl || { echo "supergfxctl missing" >&2; return 1; }
  # MUX flips latch in ACPI: a reboot is always required afterwards.
  if ! out=$(sgfx -m "$1"); then
    echo "supergfxd is not responding (try: systemctl status supergfxd)" >&2
    return 1
  fi
  [ -n "$out" ] && echo "$out"
  echo "NOTE: reboot required for the switch to $1 to take effect" >&2
}

cmd_gpu_toggle() {
  # Integrated<->Hybrid via Omarchy's tested flow: floating terminal, gum
  # confirm, config rewrite + support files + reboot. Needs a terminal for
  # the sudo prompt, so this must run where the user can see it.
  if ! have omarchy-toggle-hybrid-gpu; then
    echo "omarchy-toggle-hybrid-gpu not found (not on Omarchy?)" >&2
    return 1
  fi
  if have omarchy-launch-floating-terminal-with-presentation; then
    exec omarchy-launch-floating-terminal-with-presentation omarchy-toggle-hybrid-gpu
  fi
  exec omarchy-toggle-hybrid-gpu
}

cmd_gpu_support() {
  # TSV probe of Omarchy's Integrated support files + current config mode.
  local delay_start=false force_igpu=false cfg_mode=""
  [ -f /etc/systemd/system/supergfxd.service.d/delay-start.conf ] && delay_start=true
  [ -x /usr/lib/systemd/system-sleep/force-igpu ] && force_igpu=true
  cfg_mode=$(grep -o '"mode"[[:space:]]*:[[:space:]]*"[^"]*"' /etc/supergfxd.conf 2>/dev/null | cut -d'"' -f4 || true)
  printf 'delay_start\t%s\nforce_igpu\t%s\nconfig_mode\t%s\n' "$delay_start" "$force_igpu" "$cfg_mode"
}

cmd_battery() {
  have asusctl || { printf 'error\t%s\n' "asusctl-missing"; return 1; }
  local info=""
  if ! info=$(asusctl_out battery info); then
    printf 'error\t%s\n' "asusd-down"; return 1
  fi
  printf '%s\n' "$(echo "$info" | tr '\n' ';' | sed 's/;[[:space:]]*/; /g')"
}

cmd_battery_set() { # <20-100>
  [ $# -ge 1 ] || { echo "usage: $0 battery-set <20-100>" >&2; return 2; }
  exec asusctl battery limit "$1"
}
cmd_battery_oneshot() { # [percent] — one-shot full charge, skips the limiter once.
  if [ -n "${1:-}" ]; then
    printf '%s' "$1" | grep -Eq '^[0-9]+$' || { echo "percent must be a number" >&2; return 2; }
    exec asusctl battery oneshot "$1"
  fi
  exec asusctl battery oneshot
}

cmd_tuning() {
  local out=""
  if ! out=$(asusctl_out profile tuning 2>/dev/null); then
    echo "error\tasusd-down"; return 1
  fi
  printf 'tuning\t%s\n' "$out"
}
cmd_tuning_set() { # <true|false>
  [ $# -ge 1 ] || { echo "usage: $0 tuning-set <true|false>" >&2; return 2; }
  case "$1" in true|false) ;; *) echo "arg must be true|false" >&2; return 2 ;; esac
  exec asusctl profile tuning "$1"
}

# CPU energy preference: the EPP sysfs nodes are user-writable on this stack
# (udev), the governor node is not — so EPP is adjustable, governor is shown.
cmd_cpu() {
  local p0=/sys/devices/system/cpu/cpufreq/policy0
  [ -r "$p0/energy_performance_preference" ] || { echo "error\tno-cpufreq"; return 1; }
  local epp="" gov="" avail=""
  epp=$(tr -d ' \r\n' < "$p0/energy_performance_preference" 2>/dev/null || true)
  gov=$(tr -d ' \r\n' < "$p0/scaling_governor" 2>/dev/null || true)
  avail=$(tr -s ' \r\n' ' ' < "$p0/energy_performance_available_preferences" 2>/dev/null | sed 's/^ *//;s/ *$//' || true)
  printf 'epp\t%s\ngovernor\t%s\nepp_available\t%s\n' "$epp" "$gov" "$avail"
}
cmd_cpu_epp() { # <preference> — validated against available list, all policies.
  [ $# -ge 1 ] || { echo "usage: $0 cpu-epp <preference>" >&2; return 2; }
  local avail=""
  avail=$(tr -s ' \r\n' ' ' < /sys/devices/system/cpu/cpufreq/policy0/energy_performance_available_preferences 2>/dev/null || true)
  case " $avail " in *" $1 "*) ;; *) echo "unknown preference '$1' (available:$avail)" >&2; return 2 ;; esac
  local f ok=true
  for f in /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference; do
    [ -w "$f" ] || { echo "not writable: $f" >&2; ok=false; continue; }
    echo "$1" > "$f" 2>/dev/null || { echo "write failed: $f" >&2; ok=false; }
  done
  $ok
}

cmd_kbd() {
  # TSV: brightness. Never fails the panel on old TUFs or when asusd is down.
  local b=""
  if ! b=$(asusctl_out leds get); then
    printf 'error\t%s\n' "asusd-down"; return 1
  fi
  b=$(printf '%s' "$b" | sed -n '1s/^[^:]*:[[:space:]]*//p' | tr -d '\r\n')
  printf 'brightness\t%s\n' "$b"
}

cmd_kbd_set() { # <off|low|med|high>
  [ $# -ge 1 ] || { echo "usage: $0 kbd-set <off|low|med|high>" >&2; return 2; }
  exec asusctl leds set "$1"
}

AURA_ZONES="keyboard logo lightbar lid rear-glow"

cmd_aura_zones() {
  # TSV zone list the daemon actually manages (from its persisted config).
  # Zones asusctl accepts but the firmware doesn't expose (e.g. logo on the
  # Strix G533ZW) never appear here, so the panel can't offer dead buttons.
  local ron=""
  ron=$(ls /etc/asusd/aura_*.ron 2>/dev/null | head -n 1 || true)
  [ -n "$ron" ] && [ -r "$ron" ] || return 0
  sed -n '/states: \[/,/\],/p' "$ron" 2>/dev/null \
    | grep -o 'zone: [A-Za-z-]*' \
    | awk '{print $2}' | sort -u \
    | while IFS= read -r z; do
        printf 'zone\t%s\n' "$(printf '%s' "$z" | tr '[:upper:]' '[:lower:]')"
      done
}

cmd_aura_power() { # <zone> <on|off> — zone power states (needs asusd).
  [ $# -ge 2 ] || { echo "usage: $0 aura-power <keyboard|logo|lightbar|lid|rear-glow> <on|off>" >&2; return 2; }
  local zone="$1" state="$2"
  case " $AURA_ZONES " in *" $zone "*) ;; *) echo "unknown zone '$zone'" >&2; return 2 ;; esac
  case "$state" in
    on) exec asusctl aura power "$zone" --boot --awake ;;
    off) exec asusctl aura power "$zone" ;;
    *) echo "state must be on|off" >&2; return 2 ;;
  esac
}

cmd_aura_static() { # <rrggbb> [zone] — single-colour effect, optional zone.
  [ $# -ge 1 ] || { echo "usage: $0 aura-static <rrggbb> [zone]" >&2; return 2; }
  local colour="$1" zone="${2:-}"
  if ! printf '%s' "$colour" | grep -Eq '^[0-9a-fA-F]{6}$'; then
    echo "colour must be 6 hex digits (e.g. ff00ff)" >&2; return 2
  fi
  if [ -n "$zone" ]; then
    case " $AURA_ZONES " in *" $zone "*) ;; *) echo "unknown zone '$zone'" >&2; return 2 ;; esac
    exec asusctl aura effect static -c "$colour" --zone "$zone"
  fi
  exec asusctl aura effect static -c "$colour"
}

cmd_armoury_list() { exec asusctl armoury list; }
cmd_armoury_get() { # <attr>
  [ $# -ge 1 ] || { echo "usage: $0 armoury-get <attr>" >&2; return 2; }
  exec asusctl armoury get "$1"
}
cmd_armoury_set() { # <attr> <value>
  [ $# -ge 2 ] || { echo "usage: $0 armoury-set <attr> <value>" >&2; return 2; }
  exec asusctl armoury set "$1" "$2"
}

cmd_fan_get() { # <profile> — prints current curve data lines
  [ $# -ge 1 ] || { echo "usage: $0 fan-get <profile>" >&2; return 2; }
  exec asusctl fan-curve --mod-profile "$1"
}
cmd_fan_default() { # <profile>
  [ $# -ge 1 ] || { echo "usage: $0 fan-default <profile>" >&2; return 2; }
  exec asusctl fan-curve --mod-profile "$1" --default
}
cmd_fan_set() { # <profile> <cpu|gpu|mid> <data 30c:1%,...>
  [ $# -ge 3 ] || { echo "usage: $0 fan-set <profile> <fan> <data>" >&2; return 2; }
  exec asusctl fan-curve --mod-profile "$1" --fan "$2" --data "$3"
}
cmd_fan_enable() { # <profile> <true|false> — custom curves on/off for a profile.
  [ $# -ge 2 ] || { echo "usage: $0 fan-enable <profile> <true|false>" >&2; return 2; }
  case "$2" in true|false) ;; *) echo "second arg must be true|false" >&2; return 2 ;; esac
  exec asusctl fan-curve --mod-profile "$1" --enable-fan-curves "$2"
}

# Numeric armoury attributes, probed one by one (asusctl armoury list format
# is version-dependent; per-attr get is stable). Emits limit<TAB>attr<TAB>int
# only when a current integer parses — anything else stays hidden in the UI.
LIMIT_ATTRS="ppt_pl1_spl ppt_pl2_sppt ppt_pl3_fppt nv_dynamic_boost nv_temp_target mini_led_mode panel_od"
cmd_limits() {
  have asusctl || { echo "error\tasusctl missing"; return 1; }
  local a raw cur
  for a in $LIMIT_ATTRS; do
    raw=$(asusctl_out armoury get "$a" 2>/dev/null || true)
    cur=$(printf '%s' "$raw" | grep -o -m1 '[0-9]\+' || true)
    [ -n "$cur" ] && printf 'limit\t%s\t%s\n' "$a" "$cur"
  done
  return 0
}

cmd_anime_probe() {
  # present|absent — bare `asusctl anime` is read-only (no flags = status).
  local out=""
  out=$(asusctl_out anime 2>/dev/null || true)
  if [ -z "$out" ] || printf '%s' "$out" | grep -qi "no anime\|not found\|not supported"; then
    printf 'anime\tabsent\n'; return 0
  fi
  printf 'anime\tpresent\n'
}
cmd_anime_set() { # <on|off> <off|low|med|high>
  [ $# -ge 2 ] || { echo "usage: $0 anime-set <on|off> <off|low|med|high>" >&2; return 2; }
  case "$1" in on) e=true ;; off) e=false ;; *) echo "first arg must be on|off" >&2; return 2 ;; esac
  case "$2" in off|low|med|high) ;; *) echo "brightness must be off|low|med|high" >&2; return 2 ;; esac
  asusctl anime --enable-display "$e" --brightness "$2"
}

cmd_slash_probe() {
  # slash<TAB>present|absent + slashmode lines for the mode picker.
  local out=""
  if ! out=$(asusctl_out slash list 2>/dev/null); then
    printf 'slash\tabsent\n'; return 0
  fi
  printf 'slash\tpresent\n'
  printf '%s' "$out" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^$' \
    | sed -e 's/ [-–—].*$//' -e 's/(.*//' -e 's/[[:space:]]*$//' \
    | while IFS= read -r m; do [ -n "$m" ] && printf 'slashmode\t%s\n' "$m"; done
}
cmd_slash_set() { # <on|off> [mode|_] [0-255|_]
  [ $# -ge 1 ] || { echo "usage: $0 slash-set <on|off> [mode|_] [brightness|_]" >&2; return 2; }
  local args=()
  case "$1" in on) args+=(--enable) ;; off) args+=(--disable) ;; *) echo "first arg must be on|off" >&2; return 2 ;; esac
  if [ "${2:-_}" != "_" ] && [ -n "${2:-}" ]; then args+=(--mode "$2"); fi
  if [ "${3:-_}" != "_" ] && [ -n "${3:-}" ]; then
    printf '%s' "$3" | grep -Eq '^[0-9]+$' || { echo "brightness must be 0-255" >&2; return 2; }
    args+=(-l "$3")
  fi
  exec asusctl slash set "${args[@]}"
}

cmd_display_modes() {
  # TSV from `hyprctl monitors`: internal (focused, enabled) monitor only.
  have hyprctl || { echo "error\thyprctl missing"; return 1; }
  local raw="" name="" cur="" pos="" scale="" modes=""
  raw=$(hyprctl monitors 2>/dev/null || true)
  [ -n "$raw" ] || { echo "error\thyprctl failed"; return 1; }
  name=$(printf '%s' "$raw" | grep -m1 -o '^Monitor .*' | sed 's/^Monitor //;s/ (ID.*//' || true)
  cur=$(printf '%s' "$raw" | grep -m1 -o '[0-9]*x[0-9]*@[0-9.]*' || true)
  pos=$(printf '%s' "$raw" | grep -m1 -o 'at [0-9-]*x[0-9-]*' | sed 's/^at //' || true)
  scale=$(printf '%s' "$raw" | grep -m1 'scale:' | grep -o '[0-9.]*' || true)
  modes=$(printf '%s' "$raw" | grep -m1 'availableModes:' | sed 's/.*availableModes: *//' || true)
  [ -n "$name" ] || { echo "error\tno monitor parsed"; return 1; }
  printf 'monitor\t%s\ncurrent\t%s\npos\t%s\nscale\t%s\n' "$name" "$cur" "$pos" "$scale"
  local m
  for m in $modes; do printf 'mode\t%s\n' "$m"; done
}
cmd_display_rate() { # <name> <WxH@rate> <pos> <scale> — rate switch only.
  [ $# -ge 4 ] || { echo "usage: $0 display-rate <name> <mode> <pos> <scale>" >&2; return 2; }
  case "$2" in [0-9]*x[0-9]*@[0-9.]*) ;; *) echo "mode must look like 2560x1440@60" >&2; return 2 ;; esac
  # Modern Hyprland speaks Lua; `keyword` is rejected by the new parser.
  exec hyprctl eval "hl.monitor({ output = \"$1\", mode = \"$2\", position = \"$3\", scale = $4 })"
}

cmd_keystone() {
  # Phase-2 placeholder (see README "Keystone roadmap").
  # ASUS_WMI_DEVID_KEYSTONE = 0x00120091; PRESENCE_BIT 0x00010000 = inserted,
  # 0xFFFFFFFE = no slot. Exposed by asus-wmi sysfs when the kernel supports it.
  local found=""
  found=$(grep -rl "0x00120091\|keystone" /sys/devices/platform/asus-nb-wmi 2>/dev/null | head -n 3 || true)
  if [ -n "$found" ]; then
    printf 'slot\tpresent\nnodes\t%s\n' "$(echo "$found" | tr '\n' ';')"
  else
    printf 'slot\tunknown\nnodes\t\n'
  fi
  printf 'note\t%s\n' "Keystone actions land in Phase 2 (see README roadmap)"
}

usage() {
  cat <<'EOF'
usage: omarchy-armoury <command> [args]
  status                 TSV capability probe (asus/sgfx/asusd/product)
  profiles               TSV profile list with active flag
  profile-set <name>     asusctl profile set
  profile-next           asusctl profile next
  gpu                    TSV supergfxctl state (+ Omarchy support-file flags)
  gpu-set <mode>         direct switch, Hybrid|AsusMuxDgpu only (reboot required)
  gpu-toggle             Integrated<->Hybrid via Omarchy's terminal flow
  gpu-support            TSV probe of delay-start.conf / force-igpu hook / config mode
  battery                battery limit info
  battery-set <20-100>   set charge limit
  battery-oneshot [pct]  one-shot full charge
  tuning                 profile-tuning state (true/false)
  tuning-set <true|false>
  cpu                    TSV governor + EPP state (sysfs, no daemon needed)
  cpu-epp <preference>   set EPP on all policies
  kbd                    keyboard brightness
  kbd-set <off|low|med|high>
  aura-power <zone> <on|off>   zone power states (only detected zones work)
  aura-static <rrggbb> [zone]  single-colour effect, optional zone
  aura-zones               TSV list of Aura zones the daemon manages
  armoury-list | armoury-get <a> | armoury-set <a> <v>
  fan-get <profile> | fan-default <profile> | fan-set <profile> <fan> <data>
  fan-enable <profile> <true|false>
  limits                   TSV numeric armoury attrs (power, temp, display modes)
  anime-probe | anime-set <on|off> <off|low|med|high>
  slash-probe | slash-set <on|off> [mode|_] [brightness|_]
  display-modes | display-rate <name> <mode> <pos> <scale>
  keystone               Phase-2 placeholder probe
EOF
}

case "${1:-}" in
  status) cmd_status ;;
  profiles) cmd_profiles ;;
  profile-set) shift; cmd_profile_set "$@" ;;
  profile-next) cmd_profile_next ;;
  gpu) cmd_gpu ;;
  gpu-set) shift; cmd_gpu_set "$@" ;;
  gpu-toggle) cmd_gpu_toggle ;;
  gpu-support) cmd_gpu_support ;;
  battery) cmd_battery ;;
  battery-set) shift; cmd_battery_set "$@" ;;
  battery-oneshot) shift; cmd_battery_oneshot "$@" ;;
  tuning) cmd_tuning ;;
  tuning-set) shift; cmd_tuning_set "$@" ;;
  cpu) cmd_cpu ;;
  cpu-epp) shift; cmd_cpu_epp "$@" ;;
  kbd) cmd_kbd ;;
  kbd-set) shift; cmd_kbd_set "$@" ;;
  aura-power) shift; cmd_aura_power "$@" ;;
  aura-static) shift; cmd_aura_static "$@" ;;
  aura-zones) cmd_aura_zones ;;
  armoury-list) cmd_armoury_list ;;
  armoury-get) shift; cmd_armoury_get "$@" ;;
  armoury-set) shift; cmd_armoury_set "$@" ;;
  fan-get) shift; cmd_fan_get "$@" ;;
  fan-default) shift; cmd_fan_default "$@" ;;
  fan-set) shift; cmd_fan_set "$@" ;;
  fan-enable) shift; cmd_fan_enable "$@" ;;
  limits) cmd_limits ;;
  anime-probe) cmd_anime_probe ;;
  anime-set) shift; cmd_anime_set "$@" ;;
  slash-probe) shift; cmd_slash_probe "$@" ;;
  slash-set) shift; cmd_slash_set "$@" ;;
  display-modes) cmd_display_modes ;;
  display-rate) shift; cmd_display_rate "$@" ;;
  keystone) cmd_keystone ;;
  *) usage; exit 2 ;;
esac
